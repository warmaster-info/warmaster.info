#: en/revolution/modules/rules/pages/combat-at-a-glance.adoc:16
#: en/revolution/modules/rules/pages/shooting-at-a-glance.adoc:20
msgid "Rolls of 4+ score hits."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/combat-at-a-glance.adoc:17
#: en/revolution/modules/rules/pages/shooting-at-a-glance.adoc:22
msgid "Rolls of 5+ are needed to score hits on a defended target."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/combat-at-a-glance.adoc:18
#: en/revolution/modules/rules/pages/shooting-at-a-glance.adoc:24
msgid "Rolls of 6+ are needed to score hits on a fortified target."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/combat-at-a-glance.adoc:21
#: en/revolution/modules/rules/pages/shooting-at-a-glance.adoc:27
msgid "Remove stands where sufficient hits are scored."
msgstr ""

