#: en/revolution/modules/armies/pages/beastmen.adoc:90
#: en/revolution/modules/armies/pages/bretonnia.adoc:120
#: en/revolution/modules/armies/pages/cathay.adoc:120
#: en/revolution/modules/armies/pages/daemons.adoc:99
