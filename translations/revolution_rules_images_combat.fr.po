#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/retreat-1.svg:989
#, no-wrap
msgid "touching the enemy – the"
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/retreat-1.svg:992
#, no-wrap
msgid "player who has lost the"
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/retreat-1.svg:995
#, no-wrap
msgid "combat can decide which "
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/retreat-1.svg:998
#, no-wrap
