#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/incidental-contact.svg:1499
#, no-wrap
msgid "The defeated unit loses a stand and retreats"
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/incidental-contact.svg:1508
#, no-wrap
msgid "The victorious unit pursues."
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/incidental-contact.svg:1518
#, no-wrap
msgid "In this example, the victorious unit pursues directly forward after the"
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/incidental-contact.svg:1522
#, no-wrap
msgid "remaining enemy stands, with the right stand ‘sliding’ against the "
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/incidental-contact.svg:1526
#, no-wrap
msgid "enemy cavalry unit.  The leftmost victorious stand could be placed"
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/incidental-contact.svg:1530
#, no-wrap
msgid "into formation anywhere; it has been positioned as shown to"
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/incidental-contact.svg:1534
#, no-wrap
msgid "demonstrate how incidental contact can be used to deliberately"
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/incidental-contact.svg:1538
#, no-wrap
msgid "bring other units into an engagement."
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/pursuit-direct.svg:1795
#: en/revolution/modules/rules/images/combat/pursuit-indirect.svg:1765
#, no-wrap
msgid "The unit retreats 2 cm"
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/pursuit-direct.svg:1804
#: en/revolution/modules/rules/images/combat/pursuit-indirect.svg:1774
#, no-wrap
msgid "The victorious unit pursues"
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/pursuit-direct.svg:1813
#: en/revolution/modules/rules/images/combat/pursuit-indirect.svg:1783
#, no-wrap
msgid "New position"
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/pursuit-direct.svg:1822
#, no-wrap
msgid "This diagram shows a typical direct pursuit move where two stands have pursued straight forward and the third has been placed "
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/pursuit-direct.svg:1825
#, no-wrap
msgid "back into formation.  Note the third pursuing stand could be placed anywhere the player wants – the position shown is merely one option."
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/pursuit-indirect.svg:1792
#, no-wrap
msgid "An indirect pursuit.  No pursuper can move ‘straight forward’ so the first pursuing stand is moved as for a charge.  In this case, the pursuing unit"
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/pursuit-indirect.svg:1795
#, no-wrap
msgid "lies to the defeated unit’s side so the first pursuer moves to the flank as shown.  The second pursuer can then move into formation as the player"
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/pursuit-indirect.svg:1798
#, no-wrap
msgid "wishes – the position shown is merely one example."
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/pursuit-maintain-contact.svg:1806
#, no-wrap
msgid "The victorious infantry defeat the enemy"
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/pursuit-maintain-contact.svg:1809
#, no-wrap
msgid "infantry and cavalry units"
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/pursuit-maintain-contact.svg:1818
#, no-wrap
msgid "The losing units retreat"
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/pursuit-maintain-contact.svg:1827
#, no-wrap
msgid "The victorious infantry pursue"
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/pursuit-maintain-contact.svg:1830
#, no-wrap
msgid "the losing infantry units."
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/pursuit-maintain-contact.svg:1839
#, no-wrap
msgid "In this situation, the pursuing infantry maintain contact with the enemy cavalry because they are touching corner-to-corner."
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/pursuit-supporting.svg:2517
#, no-wrap
msgid "The losing units retreat 2 cm"
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/pursuit-supporting.svg:2526
#, no-wrap
msgid "The first victorious unit pursues"
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/pursuit-supporting.svg:2535
#, no-wrap
msgid "The second victorious unit"
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/pursuit-supporting.svg:2538
#, no-wrap
msgid "pursues to support."
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/pursuit-supporting.svg:2547
#, no-wrap
msgid "A supporting pursuit. The second victorious unit cannot see an enemy but can pursue into support."
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/pursuit-supporting.svg:2550
#, no-wrap
msgid "Notice the right victorious stand touches a losing unit corner-to-corner and therefore fights in the following round."
msgstr ""

