#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/retreat-blocked.svg:1610
#, no-wrap
msgid "On the right is the result of a retreat of"
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/retreat-blocked.svg:1613
#, no-wrap
msgid "4 cm.  The rear defeated unit moved to"
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/retreat-blocked.svg:1616
#, no-wrap
msgid "the side and away from its contacted edge"
