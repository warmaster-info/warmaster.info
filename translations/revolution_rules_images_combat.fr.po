#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/supporting-troops.svg:1777
#, no-wrap
msgid "This unit is supporting"
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/combat/supporting-troops.svg:1780
#, no-wrap
