#. type: Title ==
#: en/revolution/modules/rules/pages/flying-units-at-a-glance.adoc:5
#, no-wrap
msgid "Initative"
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/flying-units-at-a-glance.adoc:8
msgid "Flying units can use Initiative to charge if within 20cm of enemy."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/flying-units-at-a-glance.adoc:9
msgid "Flying units cannot evade."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/flying-units-at-a-glance.adoc:15
msgid ""
"Flying units more than 20cm from a character can home back up to 1D6 × 10cm "
"towards any character before orders are issued."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/flying-units-at-a-glance.adoc:21
msgid ""
"Flying units can only be issued orders if they are within 20cm of a "
"character."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/flying-units-at-a-glance.adoc:22
msgid "[.edit]#Flying units can take orders to charge enemy within 60cm.#"
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/flying-units-at-a-glance.adoc:23
msgid "Flying units under orders can move up to 100cm."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/flying-units-at-a-glance.adoc:29
msgid ""
"Flying units ignore terrain (they fly right over it) but cannot end their "
"move in a wood."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/flying-units-at-a-glance.adoc:35
msgid ""
"Characters riding a flying Monstrous Mount add its Attack value to their own."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/flying-units-at-a-glance.adoc:36
msgid ""
"Characters who ride a flying creature can move up to 100cm rather than 60cm."
msgstr ""
