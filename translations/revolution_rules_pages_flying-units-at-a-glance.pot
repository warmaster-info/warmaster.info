msgstr ""

#. type: Title ==
#: en/revolution/modules/rules/pages/flying-units-at-a-glance.adoc:4
#, no-wrap
msgid "Initative"
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/flying-units-at-a-glance.adoc:8
msgid ""
"Flying units can use Initiative to charge if within 20cm of enemy.+ Flying "
"units cannot evade."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/flying-units-at-a-glance.adoc:13
msgid ""
"Flying units more than 20cm from a character can home back up to 1D6 × 10cm "
"towards any character before orders are issued."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/flying-units-at-a-glance.adoc:18
msgid ""
"Flying units can only be issued orders if they are within 20cm of a "
"character."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/flying-units-at-a-glance.adoc:19
msgid "[.edit]#Flying units can take orders to charge enemy within 60cm.#"
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/flying-units-at-a-glance.adoc:20
msgid "Flying units under orders can move up to 100cm."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/flying-units-at-a-glance.adoc:25
msgid ""
"Flying units ignore terrain (they fly right over it) but cannot end their "
"move in a wood."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/flying-units-at-a-glance.adoc:30
msgid ""
"Characters riding a flying Monstrous Mount add its Attack value to their own."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/flying-units-at-a-glance.adoc:31
msgid ""
"Characters who ride a flying creature can move up to 100cm rather than 60cm."
msgstr ""
