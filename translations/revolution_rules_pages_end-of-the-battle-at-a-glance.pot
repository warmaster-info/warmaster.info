msgid "End of the Battle at a Glance"
msgstr ""

#. type: Title ==
#: en/revolution/modules/rules/pages/end-of-the-battle-at-a-glance.adoc:5
#, no-wrap
msgid "The battle ends"
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/end-of-the-battle-at-a-glance.adoc:8
msgid "Once both players have taken the predetermined number of turns."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/end-of-the-battle-at-a-glance.adoc:9
msgid "Once one player concedes."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/end-of-the-battle-at-a-glance.adoc:10
msgid "Once one army withdraws."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/end-of-the-battle-at-a-glance.adoc:15
msgid "An army must withdraw if:"
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/end-of-the-battle-at-a-glance.adoc:16
msgid "The General is slain."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/end-of-the-battle-at-a-glance.adoc:17
msgid "The army has lost 50% or more of its units."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/end-of-the-battle-at-a-glance.adoc:18
msgid "Once an army withdraws, the game is immediately over."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/end-of-the-battle-at-a-glance.adoc:23
msgid ""
"Each player earns victory points for enemy units and characters he destroys "
"including magic items."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/end-of-the-battle-at-a-glance.adoc:25
msgid ""
"Each player earns half victory points for enemy units reduced from three or "
"four stands to one."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/end-of-the-battle-at-a-glance.adoc:26
msgid "The player who amasses the most victory points wins the battle."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/end-of-the-battle-at-a-glance.adoc:27
msgid "A player who concedes earns no victory points."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/end-of-the-battle-at-a-glance.adoc:27
msgid "An army which withdraws cannot win the battle, though it can draw."
msgstr ""
