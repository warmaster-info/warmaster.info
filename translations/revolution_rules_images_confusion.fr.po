#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/confusion/moving-aside.svg:2812
#, no-wrap
msgid "Note that in the case of the infantry unit stand B could"
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/confusion/moving-aside.svg:2815
#, no-wrap
msgid "have been placed into a supporting position or any"
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/confusion/moving-aside.svg:2818
#, no-wrap
msgid "other formation – it need not necessarily maintain the"
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/confusion/moving-aside.svg:2821
#, no-wrap
msgid "line formation.  Similarly, apart from cavalry stand A,"
msgstr ""

#. type: Content of: <svg><g><text><tspan>
#: en/revolution/modules/rules/images/confusion/moving-aside.svg:2824
#, no-wrap
msgid "the remaining cavalry stands could have been placed"
