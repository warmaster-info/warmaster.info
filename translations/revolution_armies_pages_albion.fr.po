#: en/revolution/modules/armies/pages/albion.adoc:145
msgid ""
"_The Druid brings down a localised shower of fine, freezing rain upon his "
"foes._"
msgstr ""

#.  cms → cm
#. type: Plain text
#: en/revolution/modules/armies/pages/albion.adoc:149
