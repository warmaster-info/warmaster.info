#, no-wrap
msgid "a|\n"
msgstr "a|\n"

#. type: Title ==
#: en/revolution/modules/rules/pages/game-sequence.adoc:9
#, no-wrap
msgid "1"
msgstr "1"

#. type: Table
#: en/revolution/modules/rules/pages/game-sequence.adoc:11
#: en/revolution/modules/rules/pages/game-sequence.adoc:27
#: en/revolution/modules/rules/pages/game-sequence.adoc:93
