msgid "Roll the number of dice indicated."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/combat-at-a-glance.adoc:14
#: en/revolution/modules/rules/pages/shooting-at-a-glance.adoc:17
msgid "Rolls of 4+ score hits."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/combat-at-a-glance.adoc:15
#: en/revolution/modules/rules/pages/shooting-at-a-glance.adoc:19
msgid "Rolls of 5+ are needed to score hits on a defended target."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/combat-at-a-glance.adoc:16
#: en/revolution/modules/rules/pages/shooting-at-a-glance.adoc:21
msgid "Rolls of 6+ are needed to score hits on a fortified target."
msgstr ""

#. type: Plain text
#: en/revolution/modules/rules/pages/combat-at-a-glance.adoc:19
#: en/revolution/modules/rules/pages/shooting-at-a-glance.adoc:24
msgid "Remove stands where sufficient hits are scored."
msgstr ""

