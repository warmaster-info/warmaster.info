<!DOCTYPE html>
<html lang="{{#if site.keys.language}}{{site.keys.language}}{{else}}en{{/if}}" dir="{{#if (eq site.keys.language 'ar')}}rtl{{else}}ltr{{/if}}">
  <head>
{{> head defaultPageTitle='Untitled'}}
    <style type="text/css">
      .doc {
        margin: 0rem auto;
        max-width: 100rem;
      }
      @media screen and (min-width: 1024px) {
        .doc {
          max-width: 100rem;
        }
      }

      /*.doc h2:not(.discrete), .doc h3:not(.discrete) {
        border-bottom: none;
      }*/

      /* Blocks/tiles in a 3-wide grid. */
      .blocks2 ul, .blocks2 li, .blocks2 p,
      .blocks4 ul, .blocks4 li, .blocks4 p {
        display: block;
        padding: 0;
        margin: 0;
      }
      .blocks2 > ul,
      .blocks4 > ul {
        display: flex;
        flex-wrap: wrap;
        align-items: stretch;
        justify-content: space-between;
        gap: 1rem 0.5rem;
      }
      .blocks2 > ul > li,
      .blocks4 > ul > li {
        display: block;
        /*border: 1px solid #f2f2f2;*/
        /*box-shadow: 0 3px 3px #f2f2f2;*/
        text-align: center;
        margin-top: 0.25rem;
      }
      @media screen and (min-width: 768px) {
        .blocks2 > ul > li {
          flex-basis: calc(50% - 0.5rem);
        }
        .blocks4 > ul > li {
          flex-basis: calc(25% - 0.5rem);
        }
      }
      @media screen and (min-width: 1024px) {
        .blocks2 > ul > li {
          flex-basis: calc(50% - 0.5rem);
        }
        .blocks4 > ul > li {
          flex-basis: calc(25% - 0.5rem);
        }
      }
      .doc .blocks2 > ul > li .image:not(.left):not(.right) > img,
      .doc .blocks4 > ul > li .image:not(.left):not(.right) > img {
        margin-top: 0;
      }
      .blocks2 > ul > li ul,
      .blocks4 > ul > li ul {
        margin: 0.75rem;
      }
      .doc .ulist.blocks2 li, .doc .ulist.blocks2 li + li,
      .doc .ulist.blocks4 li, .doc .ulist.blocks4 li + li {
        margin-top: 0;
      }
    </style>
  </head>
  <body class="article{{#with (or page.attributes.role page.role)}} {{{this}}}{{/with}}">
{{> header}}
    <div class="body">
{{> main}}
    </div>
{{> footer}}
  </body>
</html>
