<header class="header">
  <nav class="navbar">
    <div class="navbar-brand">
      <a class="navbar-item" href="{{{or site.url siteRootPath}}}">{{site.title}}</a>
      {{#if env.SITE_SEARCH_PROVIDER}}
      <div class="navbar-item search hide-for-print">
        <div id="search-field" class="field">
          <input id="search-input" type="text" placeholder="Search rules and armies"{{#if page.home}} autofocus{{/if}}>
        </div>
      </div>
      {{/if}}
      <button class="navbar-burger" aria-controls="topbar-nav" aria-expanded="false" aria-label="Toggle main menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
    <div id="topbar-nav" class="navbar-menu">
      <div class="navbar-end">
        {{!--#with (resolvePage 'ROOT::index.adoc')}}<a class="navbar-item" href="{{relativize url}}">Home</a>{{/with--}}
        {{#with (resolvePage 'revolution:rules:index.adoc')}}<a class="navbar-item" href="{{relativize url}}">Rules</a>{{/with}}
        {{#with (resolvePage 'revolution:armies:index.adoc')}}<a class="navbar-item" href="{{relativize url}}">Armies</a>{{/with}}
        <div class="navbar-languagemenu navbar-item has-dropdown is-hoverable">
          <a class="navbar-link" href="#">文A</a>
          <div class="navbar-dropdown">
            <a id="lang-en" class="navbar-item" href="{{siteRootPath}}/../en{{page.url}}#">&#x1F1EC;&#x1F1E7;</a>
            <a id="lang-fr" class="navbar-item" href="{{siteRootPath}}/../fr{{page.url}}#">&#x1F1EB;&#x1F1F7;</a>
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>
